    /// 同时保留用户已有的勾选 / 取消勾选状态。
    /// </summary>
    private static void SyncSelection(List<string> hosts, HashSet<string> selected, HashSet<string> known)
    {
        var set = new HashSet<string>(hosts);
        foreach (var h in selected.Where(x => !set.Contains(x)).ToList()) selected.Remove(h);
        foreach (var h in known.Where(x => !set.Contains(x)).ToList()) known.Remove(h);
        foreach (var h in hosts)
        {
            if (!known.Contains(h)) { known.Add(h); selected.Add(h); }
        }
    }

    /// <summary>切换 / 增删环境时重置选择状态，使新环境默认全选。</summary>
    private void ResetSelection()
    {
        _selectedServerHosts.Clear();
        _knownServerHosts.Clear();
        _selectedSshHosts.Clear();
        _knownSshHosts.Clear();
    }

    private void ToggleServerHost(string host, bool check)
    {
        if (check) _selectedServerHosts.Add(host); else _selectedServerHosts.Remove(host);
    }

    private void SelectAllServers()
    {
        _selectedServerHosts.Clear();
        foreach (var h in _serverHosts) _selectedServerHosts.Add(h);
    }

    private void ClearServers() => _selectedServerHosts.Clear();

    private void ToggleSshHost(string host, bool check)
    {
        if (check) _selectedSshHosts.Add(host); else _selectedSshHosts.Remove(host);
    }

    private void SelectAllSsh()
    {
        _selectedSshHosts.Clear();
        foreach (var h in _sshHosts) _selectedSshHosts.Add(h);
    }

    private void ClearSsh() => _selectedSshHosts.Clear();

    /// <summary>按配置顺序解析出勾选的 Agent 服务器。</summary>
    private List<Server> ResolveServers()
    {
        var list = new List<Server>();
        if (_currentEnv == null) return list;
        foreach (var s in _currentEnv.ServerList)
        {
            if (string.IsNullOrWhiteSpace(s.Host)) continue;
            if (_selectedServerHosts.Contains(ServerDisplay(s))) list.Add(s);
        }
        return list;
    }

    /// <summary>按配置顺序解析出勾选的 SSH 服务器。</summary>
    private List<LinuxServer> ResolveSshServers()
    {
        var list = new List<LinuxServer>();
        if (_currentEnv == null) return list;
        foreach (var s in _currentEnv.LinuxServerList)
        {
            if (string.IsNullOrWhiteSpace(s.Host)) continue;
            if (_selectedSshHosts.Contains(SshDisplay(s))) list.Add(s);
        }
        return list;
    }

    private async Task TestAgentServer(Server srv)
    {
        var ok = await Deploy.TestAgentServerAsync(srv, GetCheckTarget(), GetCheckName(), TestLog);
        if (ok) Message.Success("Agent 服务器可达");
        else Message.Error("Agent 服务器不可达");
    }

    private void TestSsh(LinuxServer ls)
    {
        var ok = Deploy.TestSshServer(ls, TestLog);
        if (ok) Message.Success("SSH 连接成功");
        else Message.Error("SSH 连接失败");
    }

    // ---------------- Deploy ----------------

    private void OnDeployTypeChange(ChangeEventArgs e)
    {
        _deployType = e.Value?.ToString() ?? "iis";
        _allFiles.Clear();
        _selectedFiles.Clear();
    }

    private void SetDockerChannel(bool useSsh)
    {
        _dockerUseSsh = useSsh;
    }

    private void OnRollbackVersionChange(ChangeEventArgs e) => _rollbackVersion = e.Value?.ToString() ?? string.Empty;

    private string GetCheckTarget() => _deployType switch
    {
        "windowservice" => "checkwindowservice",
        "linux" => "checklinux",
        "docker" => "checkdocker",
        _ => "checkiis"
    };

    private string GetCheckName() => _deployType switch
    {
        "windowservice" => _profile?.WindowsService?.ServiceName ?? string.Empty,
        "linux" => _profile?.Linux?.ServiceName ?? string.Empty,
        "docker" => _profile?.Docker?.TargetImage ?? string.Empty,
        _ => _profile?.Iis?.WebSiteName ?? string.Empty
    };

    private void LoadFilesForSelect()
    {
        if (_profile == null) return;
        _allFiles = Deploy.GetPublishFiles(_profile);
        _selectedFiles.Clear();
        Message.Success($"共 {_allFiles.Count} 个文件");
    }

    private void ToggleFile(string file, bool check)
    {
        if (check) _selectedFiles.Add(file);
        else _selectedFiles.Remove(file);
    }

    private void SelectAllFiles()
    {
        _selectedFiles.Clear();
        foreach (var f in _allFiles) _selectedFiles.Add(f);
    }

    private void ClearSelectedFiles() => _selectedFiles.Clear();

    private void DoDeploy()
    {
        if (_profile == null || !_canOperate) return;
        if (_running) { Message.Warning("已有任务在进行中，请等待完成或先点击「停止」"); return; }
        // IIS 发布前拦截缺失 WebSiteName
        if (_deployType == "iis" && string.IsNullOrWhiteSpace(_profile.Iis?.WebSiteName))
        {
            Message.Error("IIS 发布缺少必填项「网站名称(WebSiteName)」，请先在下方填写并保存配置");
            return;
        }
        var selected = SelectEnabled ? _selectedFiles.ToList() : null;
        var servers = ResolveServers();
        var sshs = ResolveSshServers();
        if (_deployType == "docker" && _dockerUseSsh)
        {
            if (sshs.Count == 0) { Message.Error("未选择 SSH 服务器"); return; }
        }
        else if (servers.Count == 0) { Message.Error("未选择目标服务器"); return; }

        SessionManager.StartDetailDeploy(_profile, _currentEnv, servers, sshs, _deployType, _dockerUseSsh,
            selected, _remark, CurrentUser.UserName);
        Message.Info("发布已启动，可在下方实时日志查看进度");
    }

    private void DoBuildImage()
    {
        if (_profile == null || !_canOperate) return;
        if (_running) { Message.Warning("已有任务在进行中，请等待完成或先点击「停止」"); return; }
        SessionManager.StartBuildImage(_profile, CurrentUser.UserName);
        Message.Info("镜像构建已启动");
    }

    private void DoRollback()
    {
        if (_profile == null || !_canOperate || string.IsNullOrEmpty(_rollbackVersion)) return;
        if (_running) { Message.Warning("已有任务在进行中，请等待完成或先点击「停止」"); return; }
        var servers = ResolveServers();
        var sshs = ResolveSshServers();
        if (_deployType == "docker" && _dockerUseSsh)
        {
            if (sshs.Count == 0) { Message.Error("未选择 SSH 服务器"); return; }
        }
        else if (servers.Count == 0) { Message.Error("未选择目标服务器"); return; }

        SessionManager.StartRollback(_profile, _currentEnv, servers, sshs, _deployType, _dockerUseSsh,
            _rollbackVersion, CurrentUser.UserName);
        Message.Info("回滚已启动");
    }

    private async Task LoadHistory()
    {
        if (_profile == null) return;
        _history.Clear();
        _rollbackVersion = string.Empty;
        _currentVersionHint = string.Empty;
        _busy = true;
        try
        {
            if (_deployType == "docker" && _dockerUseSsh)
            {
                var ssh = ResolveSshServers().FirstOrDefault();
                if (ssh == null) { Message.Warning("未选择 SSH 服务器"); return; }
                var res = await Deploy.SshDockerHistoryAsync(_profile, ssh, TestLog);
                _currentVersionHint = res?.Item1 ?? string.Empty;
                foreach (var t in res?.Item2 ?? new List<Tuple<string, string>>())
                {
                    _history.Add(new HistoryItem
                    {
                        Version = t.Item1,
                        Label = string.IsNullOrEmpty(t.Item2) ? t.Item1 : $"{t.Item1} — {t.Item2}"
                    });
                }
            }
            else
            {
                var server = ResolveServers().FirstOrDefault();
                if (server == null) { Message.Warning("未选择目标服务器"); return; }
                var res = await Deploy.CheckVersionAsync(server, GetCheckTarget(), GetCheckName(), TestLog);
                if (res != null)
                {
                    _currentVersionHint = res.LastDeployTime;
                    foreach (var v in res.History ?? new List<string>())
                        _history.Add(new HistoryItem { Version = v, Label = v });
                }
            }
            Message.Success($"获取到 {_history.Count} 个历史版本");
        }
        catch (Exception ex) { Message.Error($"获取历史版本异常：{ex.GetType().Name}: {ex.Message}"); }
        finally { _busy = false; StateHasChanged(); }
    }

    // ---------------- 运行控制（全部委托给共享会话管理器） ----------------

    private void Cancel()
    {
        if (SessionManager.RequestCancelByProfile(Id)) Message.Info("已请求停止...");
        else Message.Warning("没有正在运行的任务");
    }

    private void Retry()
    {
        if (_session == null || _running) return;
        var newId = SessionManager.Retry(_session.Id, CurrentUser.UserName);
        if (newId == null) Message.Warning("无法重试该操作");
        else Message.Info("已按上次操作重试");
    }

    public void Dispose()
    {
        SessionManager.OnSessionUpdated -= HandleSessionUpdated;
    }

    private class HistoryItem
    {
        public string Version { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
    }
}
