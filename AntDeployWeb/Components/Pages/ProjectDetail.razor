    /// <summary>会话事件回调：仅处理本项目的会话，节流渲染（后台线程触发，须 InvokeAsync）。</summary>
    private void HandleSessionUpdated(string sessionId, DeploySession session)
    {
        if (session.ProfileId != Id) return;
        _ = InvokeAsync(() =>
        {
            _session = session;
            if (System.Threading.Interlocked.CompareExchange(ref _renderQueued, 1, 0) == 0)
            {
                _ = Task.Delay(150).ContinueWith(_ => InvokeAsync(() =>
                {
                    System.Threading.Interlocked.Exchange(ref _renderQueued, 0);
                    StateHasChanged();
                }));
            }
        });
    }

    /// <summary>手动刷新：重新载入该项目最近会话。</summary>
