    private List<string> _allFiles = new();
    private readonly HashSet<string> _selectedFiles = new();

    // 并发发布设置（项目级，存 Web 端 DeployOptions 表；实际并发 = min(上传, 部署)，钳制 [1, 选中服务器数]）
    private string _uploadMode = "count";
    private int _uploadValue = 1;
    private string _deployMode = "count";
    private int _deployValue = 1;

    // 零掉包回调 + 两阶段设置（项目级，存 Web 端 DeployOptions 表；需 Agent ≥ 7.2，旧 Agent 自动降级/忽略）
    private string _beforeCallbackUrl = string.Empty;
    private string _afterCallbackUrl = string.Empty;
    private int _drainWaitSeconds = 0;
    private int _callbackTimeoutSeconds = 10;
    private bool _enableTwoPhase = false;

    /// <summary>本次选中的目标服务器数（用于并发风险提示）。</summary>
    private int SelectedServerCount => _selectedServerHosts.Count;

    /// <summary>部署阶段有效并发（按选中服务器数解析百分比并钳制），用于风险提示。</summary>
    private int DeployEffectiveParallel =>
        ProjectDeployOptionsService.ResolveDeployParallel(
            new DeployOptionsEntity { DeployMode = _deployMode, DeployValue = _deployValue }, SelectedServerCount);

    /// <summary>红色高风险：部署并发 ≥ max(2, 服务器数一半)，或（配置了下负载回调且并发 &gt; 1）。</summary>
    private bool ShowRedRisk
    {
        get
        {
            if (SelectedServerCount <= 1) return false;
            var eff = DeployEffectiveParallel;
            var threshold = Math.Max(2, (int)Math.Ceiling(SelectedServerCount * 0.5));
            var hasBefore = !string.IsNullOrWhiteSpace(_beforeCallbackUrl);
            return eff >= threshold || (hasBefore && eff > 1);
        }
    }

    /// <summary>琥珀提示：部署并发 &gt; 1（多台同时更新），但未达红色阈值。</summary>
    private bool ShowAmberRisk => SelectedServerCount > 1 && DeployEffectiveParallel > 1 && !ShowRedRisk;

    private List<HistoryItem> _history = new();
    private string _rollbackVersion = string.Empty;
