@page "/project/{Id}"
@attribute [Authorize]
@implements IDisposable
@using AntDeploy.Core.Util
@inject IConfigStore Store
@inject DeployService Deploy
@inject DeploySessionManager SessionManager
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@inject MessageService Message
@inject ProjectDeployOptionsService DeployOptions

@if (_profile == null)
{
    <Empty Description="@("项目不存在")" />
}
else
{
    <div class="detail-header">
        <div style="min-width:0;">
            <div class="page-title" style="margin-bottom:0;">
                <Input @bind-Value="_profile.Name" Disabled="@(!_canEdit)" Style="width:280px;font-weight:600;" />
            </div>
            <div class="detail-header__meta">
                @if (!string.IsNullOrWhiteSpace(_profile.Git.RepositoryUrl))
                {
                    <span class="chip"><span class="chip__k">Git</span><span class="chip__v">@_profile.Git.RepositoryUrl</span></span>
                }
                @if (!string.IsNullOrWhiteSpace(_profile.Git.Branch))
                {
                    <span class="chip chip--brand"><span class="chip__k">分支</span><span class="chip__v">@_profile.Git.Branch</span></span>
                }
            </div>
        </div>
        <Space>
            <SpaceItem><Button Icon="arrow-left" OnClick="@(() => Nav.NavigateTo("/projects"))">返回</Button></SpaceItem>
            @if (_canEdit)
            {
                <SpaceItem><Button Type="ButtonType.Primary" Icon="save" OnClick="Save">保存配置</Button></SpaceItem>
            }
            else
            {
                <SpaceItem><span class="form-hint" style="margin:0;">只读：普通用户仅可发布，无配置权限</span></SpaceItem>
            }
        </Space>
    </div>

    <Tabs @bind-ActiveKey="_activeTab">
        <TabPane Key="git" Tab="Git 代码">
            <div class="form-grid">
                <div class="form-item">
                    <div class="form-label">仓库地址 RepositoryUrl</div>
                    <Input @bind-Value="_profile.Git.RepositoryUrl" Placeholder="https://github.com/xxx/yyy.git" />
                </div>
                <div class="form-item">
                    <div class="form-label">分支 Branch（可下拉选择 / 手工输入 / 模糊搜索）</div>
                    <BranchPicker @ref="_branchPicker"
                                  RepositoryUrl="@_profile.Git.RepositoryUrl"
                                  UserName="@_profile.Git.UserName"
                                  Password="@_profile.Git.Password"
                                  Value="@_profile.Git.Branch"
                                  ValueChanged="@(v => _profile.Git.Branch = v)"
                                  DefaultValue="@(_profile.LastPublishBranch ?? _profile.Git.Branch)"
                                  Disabled="@(!_canEdit)"
                                  ListId="detail-branch-list"
                                  Placeholder="选择或输入分支，支持模糊搜索" />
                </div>
                <div class="form-item">
                    <div class="form-label">用户名 UserName</div>
                    <Input @bind-Value="_profile.Git.UserName" />
                </div>
                <div class="form-item">
                    <div class="form-label">密码 / 令牌 Password</div>
                    <InputPassword @bind-Value="_profile.Git.Password" />
                </div>
            </div>
            <Alert Style="margin-top:12px;" Type="AlertType.Info" ShowIcon="true"
                   Message="@("开启二要素(2FA)时，密码位置请填写 Personal Access Token(PAT)")" />
            <div style="margin-top:12px;">
                <Checkbox @bind-Checked="_profile.Git.UseLocalPath">使用本地已有目录（不执行 clone/pull）</Checkbox>
            </div>
            <div class="form-hint">本地代码目录：@Store.GetProjectPath(_profile)</div>
            <Space Style="margin-top:12px;">
                <SpaceItem><Button Disabled="@(_busy || _running)" OnClick="TestConnection">测试连接</Button></SpaceItem>
                <SpaceItem><Button Disabled="@(_busy || _running)" OnClick="ReloadBranches">拉取分支</Button></SpaceItem>
                <SpaceItem><Button Type="ButtonType.Primary" Disabled="@(!_canOperate || _busy || _running)" OnClick="Pull">拉取代码</Button></SpaceItem>
                <SpaceItem><Button Danger="true" Disabled="@(!_running)" OnClick="Cancel">停止</Button></SpaceItem>
            </Space>
        </TabPane>

        <TabPane Key="build" Tab="编译发布">
            <div class="form-grid">
                <div class="form-item" style="grid-column:1 / -1;">
                    <div class="form-label">项目文件 ProjectFile（多项目仓库请指定要发布的 Web 主项目，留空则自动探测）</div>
                    <select class="native-select" value="@_profile.Build.ProjectFile" @onchange="OnProjectFileChange">
                        <option value="">（自动探测）</option>
                        @foreach (var p in _projectFiles)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="form-item">
                    <div class="form-label">项目类型 SdkType</div>
                    <select class="native-select" value="@_profile.Build.SdkType" @onchange="OnSdkTypeChange">
                        @foreach (var s in _sdkTypes)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="form-item">
                    <div class="form-label">配置 Configuration</div>
                    <Input @bind-Value="_profile.Build.Configuration" Placeholder="Release" />
                </div>
                <div class="form-item">
                    <div class="form-label">目标框架 Framework（可选）</div>
                    <Input @bind-Value="_profile.Build.Framework" Placeholder="如 net8.0 / net472" />
                </div>
                <div class="form-item">
                    <div class="form-label">运行时 Runtime（可选）</div>
                    <Input @bind-Value="_profile.Build.Runtime" Placeholder="如 win-x64 / linux-x64" />
                </div>
                <div class="form-item">
                    <div class="form-label">发布模式 NetCorePublishMode</div>
                    <select class="native-select" value="@_profile.Plugin.NetCorePublishMode" @onchange="OnPublishModeChange">
                        @foreach (var m in _publishModes)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>
                <div class="form-item">
                    <div class="form-label">额外参数 ExtraArgs（可选）</div>
                    <Input @bind-Value="_profile.Build.ExtraArgs" Placeholder="如 --self-contained false" />
                </div>
                <div class="form-item" style="grid-column:1 / -1;">
                    <div class="form-label">发布输出目录 PublishPath（可选）</div>
                    <Input @bind-Value="_profile.Build.PublishPath" Placeholder="留空则使用默认目录" />
                </div>
            </div>
            <div style="margin-top:12px;">
                <Checkbox @bind-Checked="_profile.Build.IsWeb">Web 项目（IsWeb）</Checkbox>
            </div>
            <div class="form-hint">发布输出目录：@Store.GetPublishPath(_profile)</div>
            <Space Style="margin-top:12px;">
                <SpaceItem><Button Type="ButtonType.Primary" Disabled="@(!_canOperate || _running)" OnClick="Build">编译发布</Button></SpaceItem>
                <SpaceItem><Button Disabled="@(!_canOperate || _running)" OnClick="RunPullAndBuild">拉取并编译</Button></SpaceItem>
                <SpaceItem><Button Danger="true" Disabled="@(!_running)" OnClick="Cancel">取消</Button></SpaceItem>
            </Space>
        </TabPane>

        <TabPane Key="env" Tab="环境与服务器">
            <div class="server-row">
                <span class="form-label" style="margin:0;">当前环境</span>
                <select class="native-select" style="width:220px;" value="@_envName" @onchange="OnEnvChange">
                    @foreach (var e in _profile.Envs)
                    {
                        <option value="@e.Name">@e.Name</option>
                    }
                </select>
                <Button Size="ButtonSize.Small" Disabled="@(!_canEdit)" OnClick="AddEnv">新增环境</Button>
                <Button Size="ButtonSize.Small" Danger="true" Disabled="@(!_canEdit || _profile.Envs.Count == 0)" OnClick="RemoveEnv">删除环境</Button>
            </div>

            @if (_currentEnv == null)
            {
                <Empty Description="@("暂无环境，请先新增环境")" />
            }
            else
            {
                <div class="form-item" style="max-width:320px;margin-top:8px;">
                    <div class="form-label">环境名称</div>
                    <Input @bind-Value="_currentEnv.Name" Placeholder="如 prod / test" />
                </div>

                <Divider>Agent 服务器列表（HTTP：IIS / Windows / Linux / Docker）</Divider>
                @foreach (var srv in _currentEnv.ServerList)
                {
                    <div class="server-row">
                        <Input @bind-Value="srv.NickName" Disabled="@(!_canEdit)" Placeholder="昵称" Style="width:120px;" />
                        <Input @bind-Value="srv.Host" Disabled="@(!_canEdit)" Placeholder="http://192.168.1.10:5000" Style="width:280px;" />
                        <InputPassword @bind-Value="srv.Token" Disabled="@(!_canEdit)" Placeholder="Token"  />
                        <Button Size="ButtonSize.Small" OnClick="@(() => TestAgentServer(srv))">测试</Button>
                        <Button Size="ButtonSize.Small" Danger="true" Disabled="@(!_canEdit)" OnClick="@(() => RemoveServer(srv))">移除</Button>
                    </div>
                }
                <Button Size="ButtonSize.Small" Disabled="@(!_canEdit)" OnClick="AddServer" Style="margin-top:6px;">+ 添加 Agent 服务器</Button>

                <Divider>SSH 服务器列表（Linux 上的 Docker 直连部署）</Divider>
                @foreach (var ls in _currentEnv.LinuxServerList)
                {
                    <div class="server-row">
                        <Input @bind-Value="ls.NickName" Disabled="@(!_canEdit)" Placeholder="昵称" Style="width:120px;" />
                        <Input @bind-Value="ls.Host" Disabled="@(!_canEdit)" Placeholder="192.168.1.20:22" Style="width:220px;" />
                        <Input @bind-Value="ls.UserName" Disabled="@(!_canEdit)" Placeholder="用户名" Style="width:140px;" />
                        <InputPassword @bind-Value="ls.Pwd" Disabled="@(!_canEdit)" Placeholder="密码"   />
                        <Button Size="ButtonSize.Small" OnClick="@(() => TestSsh(ls))">测试</Button>
                        <Button Size="ButtonSize.Small" Danger="true" Disabled="@(!_canEdit)" OnClick="@(() => RemoveLinuxServer(ls))">移除</Button>
                    </div>
                }
                <Button Size="ButtonSize.Small" Disabled="@(!_canEdit)" OnClick="AddLinuxServer" Style="margin-top:6px;">+ 添加 SSH 服务器</Button>

                <Divider>打包忽略列表（zip 打包时跳过）</Divider>
                <details class="ignore-help">
                    <summary>设置说明与示例（点击展开）</summary>
                    <div class="ignore-help__body">
                        <p><b>匹配规则：</b>对「相对发布根目录的路径（用 <code>/</code> 分隔）」做<b>不区分大小写</b>的<b>子串包含</b>匹配，命中即跳过。<b>不支持通配符</b>，直接填写要忽略的路径片段即可。</p>
                        <p><b>示例：</b></p>
                        <ul>
                            <li>忽略根目录 <code>Web.config</code>（及任意层级同名文件）：填 <code>Web.config</code></li>
                            <li>忽略整个 <code>Logs</code> 目录：填 <code>Logs/</code></li>
                            <li>忽略所有 pdb 文件：填 <code>.pdb</code>（注意不是 <code>*.pdb</code>，子串匹配无需星号）</li>
                            <li>只忽略子目录中的 <code>Web.config</code>、保留根目录的：填 <code>/Web.config</code></li>
                        </ul>
                        <p><b>是否区分大小写：</b>不区分（<code>web.config</code>、<code>Web.CONFIG</code> 均会被忽略）。</p>
                    </div>
                </details>
                <ListEditor Value="_currentEnv.IgnoreList" Placeholder="如 .pdb / Logs/ / Web.config" AddText="添加忽略项" />

                <Divider>备份忽略列表（Agent 备份旧版本时跳过）</Divider>
                <details class="ignore-help">
                    <summary>设置说明与示例（点击展开）</summary>
                    <div class="ignore-help__body">
                        <p><b>匹配规则（IIS / Windows 服务）：</b>对「相对路径（用 <code>/</code> 分隔）」做<b>不区分大小写</b>匹配，支持两种写法：</p>
                        <ul>
                            <li>以 <code>*</code> 开头：按<b>后缀</b>匹配，如 <code>*.pdb</code> 忽略所有 pdb、<code>*.log</code> 忽略所有日志；</li>
                            <li>其它写法：按<b>正则表达式</b>匹配（不区分大小写），如 <code>Web\.config</code>、<code>Logs/</code>。</li>
                        </ul>
                        <p><b>示例：</b></p>
                        <ul>
                            <li>忽略根目录 <code>Web.config</code>：填 <code>Web\.config</code>（正则中 <code>.</code> 需转义）</li>
                            <li>忽略整个 <code>Logs</code> 目录：填 <code>Logs/</code></li>
                            <li>忽略所有 pdb：填 <code>*.pdb</code></li>
                        </ul>
                        <p><b>是否区分大小写：</b>IIS / Windows 服务不区分；<b>Docker / Linux 服务</b>的备份由服务器端 <code>rsync --exclude-from</code> 执行，规则为 rsync 排除语法（<b>区分大小写</b>、支持 glob），如 <code>Logs/</code>、<code>*.pdb</code>。</p>
                    </div>
                </details>
                <ListEditor Value="_currentEnv.WindowsBackUpIgnoreList" Placeholder="如 *.pdb / Logs/ / Web\.config" AddText="添加备份忽略项" />
            }
        </TabPane>

        <TabPane Key="deploy" Tab="部署回滚">
            <div class="form-grid">
                <div class="form-item">
                    <div class="form-label">部署类型</div>
                    <select class="native-select" value="@_deployType" @onchange="OnDeployTypeChange">
                        @foreach (var t in _deployTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                @if (_deployType == "docker")
                {
                    <div class="form-item">
                        <div class="form-label">部署通道</div>
                        <div style="display:flex;gap:16px;align-items:center;height:32px;">
                            <label><input type="radio" name="dchannel" checked="@(!_dockerUseSsh)" @onchange="@(() => SetDockerChannel(false))" /> Agent(HTTP)</label>
                            <label><input type="radio" name="dchannel" checked="@_dockerUseSsh" @onchange="@(() => SetDockerChannel(true))" /> SSH 直连</label>
                        </div>
                    </div>
                }
                <div class="form-item" style="grid-column:1 / -1;">
                    <div class="form-label">目标服务器（默认全选，可勾选一个或多个）</div>
                    @if (_deployType == "docker" && _dockerUseSsh)
                    {
                        @if (_sshHosts.Count == 0)
                        {
                            <div class="form-hint">当前环境未配置 SSH 服务器，请到「环境与服务器」添加</div>
                        }
                        else
                        {
                            <Space Style="margin-bottom:6px;">
                                <SpaceItem><Button Size="ButtonSize.Small" OnClick="SelectAllSsh">全选</Button></SpaceItem>
                                <SpaceItem><Button Size="ButtonSize.Small" OnClick="ClearSsh">清空</Button></SpaceItem>
                                <SpaceItem><span class="form-hint" style="margin:0;">已选 @_selectedSshHosts.Count / @_sshHosts.Count</span></SpaceItem>
                            </Space>
                            <div style="max-height:180px;overflow-y:auto;border:1px solid #eee;border-radius:4px;padding:8px;">
                                @foreach (var h in _sshHosts)
                                {
                                    var host = h;
                                    <div><Checkbox Checked="_selectedSshHosts.Contains(host)" CheckedChanged="@(v => ToggleSshHost(host, v))">@host</Checkbox></div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @if (_serverHosts.Count == 0)
                        {
                            <div class="form-hint">当前环境未配置 Agent 服务器，请到「环境与服务器」添加</div>
                        }
                        else
                        {
                            <Space Style="margin-bottom:6px;">
                                <SpaceItem><Button Size="ButtonSize.Small" OnClick="SelectAllServers">全选</Button></SpaceItem>
                                <SpaceItem><Button Size="ButtonSize.Small" OnClick="ClearServers">清空</Button></SpaceItem>
                                <SpaceItem><span class="form-hint" style="margin:0;">已选 @_selectedServerHosts.Count / @_serverHosts.Count</span></SpaceItem>
                            </Space>
                            <div style="max-height:180px;overflow-y:auto;border:1px solid #eee;border-radius:4px;padding:8px;">
                                @foreach (var h in _serverHosts)
                                {
                                    var host = h;
                                    <div><Checkbox Checked="_selectedServerHosts.Contains(host)" CheckedChanged="@(v => ToggleServerHost(host, v))">@host</Checkbox></div>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="form-item" style="grid-column:1 / -1;">
                    <div class="form-label">并发设置（同时上传 / 同时发布更新的服务器数量）</div>
                    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:center;">
                        <span style="display:inline-flex;align-items:center;gap:6px;">
                            上传并发
                            <select class="native-select" style="width:110px;" value="@_uploadMode" @onchange="OnUploadModeChange" disabled="@(!_canEdit)">
                                <option value="count">数量</option>
                                <option value="percent">百分比</option>
                            </select>
                            <AntDesign.InputNumber TValue="int" @bind-Value="_uploadValue" Min="1" Max="9999" Disabled="@(!_canEdit)" Style="width:100px;" />
                        </span>
                        <span style="display:inline-flex;align-items:center;gap:6px;">
                            部署并发
                            <select class="native-select" style="width:110px;" value="@_deployMode" @onchange="OnDeployModeChange" disabled="@(!_canEdit)">
                                <option value="count">数量</option>
                                <option value="percent">百分比</option>
                            </select>
                            <AntDesign.InputNumber TValue="int" @bind-Value="_deployValue" Min="1" Max="9999" Disabled="@(!_canEdit)" Style="width:100px;" />
                        </span>
                    </div>
                    <div class="form-hint">实际并发 = 上传与部署并发的较小值；百分比按本次选中服务器数向上取整；1 表示逐台顺序发布。修改后点「保存配置」生效。</div>
                    @if (ShowRedRisk)
                    {
                        <div class="form-hint" style="color:#cf1322;font-weight:600;">高风险：部署并发 @(DeployEffectiveParallel) 台（已选中 @(SelectedServerCount) 台），多台将同时下线更新，可能丢失在途请求@(string.IsNullOrWhiteSpace(_beforeCallbackUrl) ? "" : "；且已配置更新前下负载回调，多台同时摘除会放大掉包风险")。零掉包建议：部署并发设为 1（滚动发布），并勾选下方「先全部上传再部署」+ 配置下/上负载回调。</div>
                    }
                    else if (ShowAmberRisk)
                    {
                        <div class="form-hint" style="color:#d48806;">注意：部署并发 @(DeployEffectiveParallel) 台（大于 1），多台将同时更新，这些节点会在同一时刻短暂不可用；如需零掉包请把部署并发设为 1（滚动发布）。</div>
                    }
                </div>
                <div class="form-item" style="grid-column:1 / -1;">
                    <div class="form-label">发布回调（选填，零掉包）— 更新前下负载、更新成功后上负载</div>
                    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start;">
                        <span style="display:inline-flex;flex-direction:column;gap:4px;min-width:300px;">
                            <span>更新前调用（下负载）</span>
                            <Input @bind-Value="_beforeCallbackUrl" Disabled="@(!_canEdit)" Placeholder="http(s)://... 或以 / 开头（Agent 调本机站点端口）" />
                        </span>
                        <span style="display:inline-flex;flex-direction:column;gap:4px;min-width:300px;">
                            <span>更新成功后调用（上负载）</span>
                            <Input @bind-Value="_afterCallbackUrl" Disabled="@(!_canEdit)" Placeholder="http(s)://... 或以 / 开头（Agent 调本机站点端口）" />
                        </span>
                        <span style="display:inline-flex;align-items:center;gap:6px;">
                            调用后等待秒数
                            <AntDesign.InputNumber TValue="int" @bind-Value="_drainWaitSeconds" Min="0" Max="3600" Disabled="@(!_canEdit)" Style="width:100px;" />
                        </span>
                        <span style="display:inline-flex;align-items:center;gap:6px;">
                            回调超时秒数
                            <AntDesign.InputNumber TValue="int" @bind-Value="_callbackTimeoutSeconds" Min="1" Max="300" Disabled="@(!_canEdit)" Style="width:100px;" />
                        </span>
                    </div>
                    <div class="form-hint">完整 http(s):// 由 Agent 直接调用；以 / 开头则由 Agent 调本机 127.0.0.1 的站点端口（仅 IIS 能自动解析端口）。「调用后等待秒数」用于下负载后等待在途请求处理完再更新站点。留空即不回调。需 Agent 版本 ≥ 7.2，否则回调不生效。</div>
                    @if (_deployType == "iis")
                    {
                        <div style="margin-top:10px;">
                            <Checkbox @bind-Checked="_enableTwoPhase" Disabled="@(!_canEdit)">先全部上传到所有服务器，再开始部署（两阶段，推荐用于零掉包滚动发布）</Checkbox>
                            <div class="form-hint">阶段1 并行把包上传解压到所有服务器（站点保持运行）；阶段2 逐台部署（部署并发=1 即滚动，配合下/上负载回调可做到零掉包）。仅 IIS 类型支持；需 Agent 版本 ≥ 7.2，否则发布时自动降级为原子发布并告警。</div>
                        </div>
                    }
                </div>
                <div class="form-item">
                    <div class="form-label">部署备注 Remark（可选）</div>
                    <Input @bind-Value="_remark" Placeholder="本次部署说明" />
                </div>
            </div>

            <DeployTypeConfig Profile="@_profile" Type="@_deployType" />

            @if (SelectEnabled)
            {
                <Divider>选择要部署的文件</Divider>
                <Space Style="margin-bottom:8px;">
                    <SpaceItem><Button Size="ButtonSize.Small" OnClick="LoadFilesForSelect">刷新文件列表</Button></SpaceItem>
                    <SpaceItem><Button Size="ButtonSize.Small" OnClick="SelectAllFiles">全选</Button></SpaceItem>
                    <SpaceItem><Button Size="ButtonSize.Small" OnClick="ClearSelectedFiles">清空</Button></SpaceItem>
                    <SpaceItem><span class="form-hint" style="margin:0;">已选 @_selectedFiles.Count / @_allFiles.Count</span></SpaceItem>
                </Space>
                <div style="max-height:220px;overflow-y:auto;border:1px solid #eee;border-radius:4px;padding:8px;">
                    @foreach (var f in _allFiles)
                    {
                        var file = f;
                        <div>
                            <Checkbox Checked="_selectedFiles.Contains(file)" CheckedChanged="@(v => ToggleFile(file, v))">@file</Checkbox>
                        </div>
                    }
                </div>
            }

            <Space Style="margin-top:16px;">
                <SpaceItem><Button Type="ButtonType.Primary" Disabled="@(!_canOperate || _running)" OnClick="DoDeploy">发布</Button></SpaceItem>
                @if (_deployType == "docker")
                {
                    <SpaceItem><Button Disabled="@(!_canOperate || _running)" OnClick="DoBuildImage">构建镜像(jib)</Button></SpaceItem>
                }
                <SpaceItem><Button Danger="true" Disabled="@(!_running)" OnClick="Cancel">停止</Button></SpaceItem>
                <SpaceItem><Button Disabled="@(_running || _session == null)" OnClick="Retry">重试</Button></SpaceItem>
            </Space>

            <Divider>版本历史与回滚</Divider>
            <Space>
                <SpaceItem><Button Size="ButtonSize.Small" Disabled="@(_busy || _running)" OnClick="LoadHistory">拉取历史版本</Button></SpaceItem>
                <SpaceItem>
                    <select class="native-select" style="width:320px;" value="@_rollbackVersion" @onchange="OnRollbackVersionChange">
                        <option value=""></option>
                        @foreach (var h in _history)
                        {
                            <option value="@h.Version">@h.Label</option>
                        }
                    </select>
                </SpaceItem>
                <SpaceItem><Button Disabled="@(_running || string.IsNullOrEmpty(_rollbackVersion))" OnClick="DoRollback">回滚</Button></SpaceItem>
            </Space>
            @if (!string.IsNullOrEmpty(_currentVersionHint))
            {
                <div class="form-hint">当前版本：@_currentVersionHint</div>
            }
        </TabPane>
    </Tabs>

    <DeployLogConsole Lines="LogLines"
                      Live="_running"
                      SubHeader="@LogSubHeader"
                      ContainerStyle="margin-top:20px;">
        <Actions>
            <Button Size="ButtonSize.Small" OnClick="RefreshSession">刷新</Button>
        </Actions>
    </DeployLogConsole>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    /// <summary>查询参数 ?tab=deploy 用于从项目列表「去填写」直达部署回滚页并展示 IIS 配置。</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private DeployProfile? _profile;
