    /// <summary>运行态来自共享会话（跨用户/刷新一致）。</summary>
    private bool _running => _session?.IsRunning == true;

    /// <summary>渲染线程安全地快照会话日志（后台线程在 LogLock 下追加）。</summary>
    private List<LogEntry> LogLines
    {
        get
