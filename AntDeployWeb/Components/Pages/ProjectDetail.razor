    };

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.LoadAsync();
        _canEdit = CurrentUser.CanEditProject(Id);
        _canOperate = CurrentUser.CanPublishProject(Id);
        _profile = Store.GetProfile(Id);
