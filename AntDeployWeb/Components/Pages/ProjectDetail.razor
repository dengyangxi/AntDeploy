    private readonly string[] _publishModes =
    {
        "FDD", "win-x64(runtime)", "win-x86(runtime)", "linux-x64(runtime)", "osx-x64(runtime)"
    };

    private string _envName = string.Empty;
    private Env? _currentEnv;

    private string _deployType = "iis";
    private List<string> _serverHosts = new();
    private readonly HashSet<string> _selectedServerHosts = new();
    private readonly HashSet<string> _knownServerHosts = new();

