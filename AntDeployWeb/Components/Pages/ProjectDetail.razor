        // ?tab=deploy 直达部署回滚页，部署类型取最近使用（回退 iis），使 IIS 配置直接可见
        if (string.Equals(Tab, "deploy", StringComparison.OrdinalIgnoreCase))
        {
            _activeTab = "deploy";
            _deployType = DeploySessionManager.NormalizeDeployType(_profile.LastDeployType);
        }

        // 载入并发发布设置（未配置时服务返回默认 count=1，即逐台顺序发布）
        var opt = DeployOptions.GetOptions(Id);
        _uploadMode = opt.UploadMode;
        _uploadValue = opt.UploadValue;
        _deployMode = opt.DeployMode;
        _deployValue = opt.DeployValue;
        _beforeCallbackUrl = opt.BeforeCallbackUrl ?? string.Empty;
        _afterCallbackUrl = opt.AfterCallbackUrl ?? string.Empty;
        _drainWaitSeconds = opt.DrainWaitSeconds;
        _callbackTimeoutSeconds = opt.CallbackTimeoutSeconds > 0 ? opt.CallbackTimeoutSeconds : 10;
        _enableTwoPhase = opt.EnableTwoPhase;

        // 载入该项目最近会话（运行中优先），订阅事件实现跨用户/刷新实时同步
        _session = SessionManager.GetLatestSession(Id);
        SessionManager.OnSessionUpdated += HandleSessionUpdated;
