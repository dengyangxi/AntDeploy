    private void RefreshServerHosts()
    {
        _serverHosts = (_currentEnv?.ServerList ?? new List<Server>())
            .Where(s => !string.IsNullOrWhiteSpace(s.Host))
            .Select(ServerDisplay)
            .ToList();
