{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=App_Data/antdeploy.db",
    "HistoryMaxRecords": 100
  },
  "Auth": {
    "CookieName": "antdeploy_auth",
    "ExpireDays": 3650,
    "DefaultAdmin": {
      "UserName": "admin",
      "Password": "admin123",
      "DisplayName": "超级管理员"
    }
  }
}
